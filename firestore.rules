rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Favorites collection
    match /favorites/{favoriteId} {
      // Allow read if authenticated and it's the user's own favorite
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow create if authenticated and favoriteId follows pattern userId_mealId
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       favoriteId == request.auth.uid + '_' + request.resource.data.mealId;
      
      // Allow delete if authenticated and it's the user's own favorite
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Disallow updates (favorites are create/delete only)
      allow update: if false;
    }
    
    // Cart collection
    match /cart/{cartItemId} {
      // Allow read if authenticated and it's the user's own cart item
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow create if authenticated and userId matches
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Allow update if authenticated and it's the user's own cart item
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Allow delete if authenticated and it's the user's own cart item
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
    }
    
    // Users collection (if you add user profiles later)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
